    {
      "parameters": {
        "jsCode": "const allIssues = $('1. Get All Week Issues').all()\n  .map(i => i.json)\n  .filter(item => item && item.number && !item.pull_request);\n\nconst openIssues = $('2. Get Open Week Issues').all()\n  .map(i => i.json)\n  .filter(item => item && item.number && !item.pull_request);\n\nconst closedIssues = $('3. Get Closed Week Issues').all()\n  .map(i => i.json)\n  .filter(item => item && item.number && !item.pull_request);\n\nconst comments = $('4. Get Week Comments').all()\n  .map(i => i.json)\n  .filter(item => item && item.id);\n\nconst byType = { bug: 0, feature: 0, task: 0, 'needs-triage': 0 };\nconst byAuthor = {};\n\nfor (const issue of allIssues) {\n  const author = issue.user?.login || 'unknown';\n  byAuthor[author] = (byAuthor[author] || 0) + 1;\n\n  const labels = (issue.labels || []).map(l => l.name);\n  for (const key of Object.keys(byType)) {\n    if (labels.includes(key)) {\n      byType[key]++;\n    }\n  }\n}\n\nconst prevRows = $('Get Previous Week Stats').all()\n  .map(r => r.json)\n  .filter(r => r && r.total !== undefined);\n\nconst prev = prevRows.length > 0\n  ? prevRows[prevRows.length - 1]\n  : { total: 0, bugs: 0, features: 0, tasks: 0, needs_triage: 0 };\n\nconst fmtDelta = (curr, old) => {\n  const d = Number(curr) - Number(old || 0);\n  return d > 0 ? `+${d}` : `${d}`;\n};\n\nconst delta = {\n  total: fmtDelta(allIssues.length, prev.total),\n  bugs: fmtDelta(byType.bug, prev.bugs),\n  features: fmtDelta(byType.feature, prev.features),\n  tasks: fmtDelta(byType.task, prev.tasks),\n  needs_triage: fmtDelta(byType['needs-triage'], prev.needs_triage)\n};\n\nconst authorRowsHtml = Object.entries(byAuthor)\n  .map(([author, count]) => `<tr><td style=\"padding:6px 12px;border:1px solid #ddd;\">${author}</td><td style=\"padding:6px 12px;border:1px solid #ddd;\">${count}</td></tr>`)\n  .join('') || '<tr><td colspan=\"2\" style=\"padding:6px 12px;border:1px solid #ddd;\">Нет данных</td></tr>';\n\nreturn [{\n  json: {\n    week_date: new Date().toISOString().slice(0, 10),\n    total: allIssues.length,\n    open_count: openIssues.length,\n    closed_count: closedIssues.length,\n    comments_count: comments.length,\n    bugs: byType.bug,\n    features: byType.feature,\n    tasks: byType.task,\n    needs_triage: byType['needs-triage'],\n    prev,\n    delta,\n    byAuthor,\n    authorRowsHtml\n  }\n}];"
      },
