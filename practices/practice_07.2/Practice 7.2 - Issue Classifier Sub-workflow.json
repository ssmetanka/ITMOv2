    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify this GitHub Issue into one of: bug, task, feature, unknown.\nRules:\n- \"bug\": crash, error, broken functionality with reproduction steps or clear problem.\n- \"feature\": request for new functionality or improvement.\n- \"task\": question, documentation update, refactoring, or configuration help.\n- \"unknown\": vague, ambiguous, or too short description without details (e.g. \"it doesn't work\", \"sometimes glitches\"). If vague, ALWAYS set type to \"unknown\" and confidence below 0.6.\n\nTitle: {{ $json.title }}\nBody: {{ $json.body || \"No description\" }}",
        "hasOutputParser": true
      },
      "id": "591c5d1d-70bf-43db-9f68-e08048584d56",
