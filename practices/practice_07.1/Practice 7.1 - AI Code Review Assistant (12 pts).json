    {
      "parameters": {
        "jsCode": "const triggerData = $('GitHub Trigger').first().json.body;\nconst prDetails = $('Get PR Details').first().json;\nconst modelChoice = $('Set Model 1').isExecuted ? 'primary' : 'other';\nconst results = [];\n\nfor (const item of $input.all()) {\n  const file = item.json;\n  if (!file.patch) continue;\n\n  const hunks = file.patch.split(/(?=^@@ -\\d+)/m);\n  for (const hunk of hunks) {\n    const headerMatch = hunk.match(/^@@ -(\\d+)(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@/);\n    if (!headerMatch) continue;\n\n    let leftLine = parseInt(headerMatch[1], 10);\n    let rightLine = parseInt(headerMatch[2], 10);\n    let targetLine = null;\n    let targetSide = 'RIGHT';\n    let lastRight = null;\n    let lastLeft = null;\n\n    const lines = hunk.split('\\n').slice(1);\n    for (const line of lines) {\n      if (!line) continue;\n\n      if (line.startsWith('+')) {\n        targetLine = rightLine;\n        targetSide = 'RIGHT';\n        lastRight = rightLine;\n        rightLine++;\n      } else if (line.startsWith('-')) {\n        lastLeft = leftLine;\n        leftLine++;\n      } else if (!line.startsWith('\\\\')) {\n        lastRight = rightLine;\n        lastLeft = leftLine;\n        rightLine++;\n        leftLine++;\n      }\n    }\n\n    if (targetLine === null) {\n      if (lastRight !== null) {\n        targetLine = lastRight;\n        targetSide = 'RIGHT';\n      } else {\n        targetLine = lastLeft;\n        targetSide = 'LEFT';\n      }\n    }\n\n    results.push({\n      json: {\n        repo_full_name: triggerData.repository.full_name,\n        pr_number: triggerData.issue.number,\n        commit_id: prDetails.head.sha,\n        filename: file.filename,\n        line: targetLine,\n        side: targetSide,\n        code_block: hunk,\n        model_choice: modelChoice\n      }\n    });\n  }\n}\n\nreturn results;"
      },
