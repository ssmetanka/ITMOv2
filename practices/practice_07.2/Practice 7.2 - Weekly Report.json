      "id": "e6bc5df6-5987-4878-9e48-08e91adb7cfb",
      "name": "Get Previous Week Stats",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        848,
        -96
      ],
      "executeOnce": true,
      "alwaysOutputData": true
